{
  "type": "object",
  "properties": {
    "state_dir": {
      "type": "string",
      "minLength": 1
    },
    "git": {
      "type": "object",
      "properties": {
        "remote": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9/._-]*$"
        }
      },
      "additionalProperties": false
    },
    "codex": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "model": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "compose_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runner_service": {
          "type": "string"
        },
        "runner_workdir": {
          "type": "string"
        },
        "external_containers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "env_file": {
          "type": "string"
        },
        "readiness_timeout": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "baseline": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      }
    },
    "timeouts": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "integer",
          "minimum": 1
        },
        "test": {
          "type": "integer",
          "minimum": 1
        },
        "docker": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "loop": {
      "type": "object",
      "properties": {
        "max_stage_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_stage_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
