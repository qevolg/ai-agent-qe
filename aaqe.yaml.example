# Optional: save as aaqe.yaml in the audited project, or use --config PATH.
# No configuration file is needed for a normal audit.

codex:
  model: gpt-6.1-sol

# Git remote and its default branch are discovered automatically.
# Override only when auditing a different target.
# git:
#   remote: upstream
#   branch: develop

# Leave empty to discover the product environment from repository evidence.
environment: {}
# environment:
#   compose_files: [tests/compose.yaml]
#   services: [database]
#   runner_service: runner
#   runner_workdir: /workspace
#   readiness_timeout: 600
#   setup: []
#   readiness: []
#   env_file: /private/product.env

references: []
baseline: []
test_paths:
  - tests/**
  - test/**
  - "**/tests/**"
  - "**/test/**"
  - .aaqe/tests/**

# Uses authenticated glab on the host; project defaults to the Git remote.
# Override when an SSH alias hides the GitLab host.
# publication:
#   project: https://gitlab.example/group/product
