# Optional project overrides. Save as aaqe.yaml or pass --config PATH.
# Omit this file entirely when AAQE can discover everything from the project.

# Source revision to audit; omit this section for origin/main.
git:
  # Existing Git remote to fetch.
  remote: origin
  # Branch on that remote to use for a new Run.
  branch: main

# Extra behavioral specifications or documentation URLs for the audit.
references: []

# Trusted baseline commands (argv arrays), executed without generated tests.
# Leave empty to discover existing tests from repository evidence.
baseline: []

# Optional existing project environment; omit for automatic discovery.
# environment:
#   # Compose files relative to the audited project root.
#   compose_files: [tests/compose.yaml]
#   # Compose service that executes build and test commands.
#   runner_service: runner
#   # Project working directory inside that runner.
#   runner_workdir: /workspace
#   # Private environment file; relative paths resolve beside this YAML file.
#   env_file: /private/product.env

# Optional delivery override; the default project comes from the Git remote.
# publication:
#   # GitLab project URL for the accepted test patch.
#   project: https://gitlab.example/group/product
