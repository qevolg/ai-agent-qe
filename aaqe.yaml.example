# Optional: save as aaqe.yaml in the audited project, or use --config PATH.
# Defaults shown below. All timeout values are seconds.
state_dir: ~/.aaqe/runs

git:
  remote: origin
  branch: main

codex:
  command: [codex]
  model: gpt-6.1-sol

timeouts:
  agent: 7200
  test: 7200
  docker: 3600

loop:
  max_stage_calls: 20
  max_stage_attempts: 4
  timeout: 43200

# Leave empty to discover the product environment from repository evidence.
environment: {}
# environment:
#   compose_files: [tests/compose.yaml]
#   services: [database]
#   runner_service: runner
#   runner_workdir: /workspace
#   readiness_timeout: 600
#   setup: []
#   readiness: []
#   env_file: /private/product.env

references: []
baseline: []
test_paths:
  - tests/**
  - test/**
  - "**/tests/**"
  - "**/test/**"
  - .aaqe/tests/**

# Uses authenticated glab on the host; project defaults to the Git remote.
# publication:
#   project: https://gitlab.example/group/product
#   glab_command: [glab]
