{
  "type": "object",
  "properties": {
    "git": {
      "type": "object",
      "properties": {
        "remote": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9/._-]*$"
        }
      },
      "additionalProperties": false
    },
    "codex": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "compose_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runner_service": {
          "type": "string"
        },
        "runner_workdir": {
          "type": "string"
        },
        "external_containers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "env_file": {
          "type": "string"
        },
        "readiness_timeout": {
          "type": "integer",
          "minimum": 1
        },
        "compose": {
          "type": [
            "object",
            "string",
            "null"
          ],
          "description": "Inline Docker Compose object, or a JSON-encoded object. Mutually exclusive with nonempty compose_files."
        },
        "readiness": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          }
        },
        "setup": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "description": "Idempotent argv commands installed as user 0 in the owned runner before readiness. Independent of generated tests."
        }
      },
      "additionalProperties": false
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "baseline": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      }
    },
    "publication": {
      "type": "object",
      "properties": {
        "project": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
