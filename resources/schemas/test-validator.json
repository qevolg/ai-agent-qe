{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "test_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "not_reproduced",
              "blocked",
              "invalid_test",
              "flaky"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "candidate_id",
          "test_ids",
          "status",
          "rationale",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "verdicts"
  ],
  "additionalProperties": false
}
