{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "coverage_assessment": {
      "type": ["object", "null"],
      "properties": {
        "scope_valid": {"type": "boolean"},
        "measurement_valid": {"type": "boolean"},
        "meaningful_assertions": {"type": "boolean"},
        "rationale": {"type": "string", "minLength": 1}
      },
      "required": ["scope_valid", "measurement_valid", "meaningful_assertions", "rationale"],
      "additionalProperties": false
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "test_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "not_reproduced",
              "blocked",
              "invalid_test",
              "flaky"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assessment": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "executed": {
                "type": "boolean"
              },
              "assertion_failed": {
                "type": "boolean"
              },
              "infrastructure_failure": {
                "type": "boolean"
              },
              "no_mocks": {
                "type": "boolean"
              },
              "real_services_verified": {
                "type": "boolean"
              }
            },
            "required": [
              "executed",
              "assertion_failed",
              "infrastructure_failure",
              "no_mocks",
              "real_services_verified"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "candidate_id",
          "test_ids",
          "status",
          "rationale",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "verdicts"
  ],
  "additionalProperties": false
}
