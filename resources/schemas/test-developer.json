{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "patch": {
      "type": "string"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "candidate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "report": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "expected_names": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reproduction_commands": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "baseline": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "service_checks": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "service": {"type": "string", "minLength": 1},
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {"type": "string", "minLength": 1, "maxLength": 8192}
                }
              },
              "required": ["service", "command"],
              "additionalProperties": false
            },
            "description": "One real protocol/version check per Designer real_services entry, executed in the runner before each target."
          }
        },
        "required": [
          "id",
          "candidate_id",
          "command",
          "reproduction_commands",
          "service_checks"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coverage": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "report": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\.json$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "command",
        "report",
        "files"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "summary",
    "patch",
    "tests",
    "limitations"
  ],
  "additionalProperties": false
}
