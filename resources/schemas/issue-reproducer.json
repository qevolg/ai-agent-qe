        "required": [
          "id",
          "title",
          "scenario_ids",
          "expected",
          "observed",
          "trigger",
          "reproduction",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "followups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "scenario_id",
          "reason"
        ],
        "additionalProperties": false
      }
