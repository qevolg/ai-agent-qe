{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path",
          "line",
          "claim"
        ],
        "additionalProperties": false
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entry_points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "sql",
              "api",
              "explorer",
              "cli"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "applicable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "description",
          "applicable",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "external",
              "docker"
            ]
          },
          "endpoint": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "compose_service": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "check": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "name",
          "source",
          "endpoint",
          "compose_service",
          "version",
          "check"
        ],
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "compose_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runner_service": {
          "type": "string"
        },
        "runner_workdir": {
          "type": "string"
        },
        "external_containers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "readiness_timeout": {
          "type": "integer",
          "minimum": 1
        },
        "compose": {
          "type": [
            "object",
            "string",
            "null"
          ],
          "description": "Inline Docker Compose object, or a JSON-encoded object. Mutually exclusive with nonempty compose_files."
        },
        "readiness": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          }
        },
        "setup": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "description": "Idempotent argv commands installed as user 0 in the owned runner before readiness. Independent of generated tests."
        }
      },
      "required": [
        "compose_files",
        "services",
        "runner_service",
        "runner_workdir",
        "external_containers",
        "readiness_timeout"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "summary",
    "scope",
    "references",
    "uncertainties",
    "entry_points",
    "services",
    "environment"
  ],
  "additionalProperties": false
}
